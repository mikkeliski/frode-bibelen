[Unit]
Description=Bygg og start øvingssiden på nytt ved nye commits
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/frode-deploy
StateDirectory=frode-deploy
# Første bygging laster ned TeX Live til bibel-PDF-en og kan ta litt tid.
TimeoutStartSec=30min
